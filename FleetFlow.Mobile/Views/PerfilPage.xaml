<?xml version="1.0" encoding="utf-8" ?>
<!--
    TELA DE PERFIL DO USUÁRIO — FleetFlow
    Mostra os dados do usuário logado (mock) e o botão "Sair da conta",
    que volta para a tela de login.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FleetFlow.Mobile.Views.PerfilPage"
             Title="Perfil"
             Shell.NavBarIsVisible="False">

    <ScrollView Padding="24">
        <VerticalStackLayout Spacing="0">

            <!-- ===== BLOCO SUPERIOR: avatar + nome + e-mail ===== -->
            <!-- Avatar circular âmbar com as iniciais "JP" -->
            <Frame HeightRequest="100"
                   WidthRequest="100"
                   CornerRadius="50"
                   Padding="0"
                   BackgroundColor="{StaticResource AmbarDourado}"
                   BorderColor="Transparent"
                   HasShadow="False"
                   HorizontalOptions="Center"
                   Margin="0,16,0,16">
                <Label Text="JP"
                       TextColor="{StaticResource Petroleo}"
                       FontFamily="OpenSansSemibold"
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Frame>

            <!-- Nome completo do usuário -->
            <Label Text="João Pedro Silva"
                   Style="{StaticResource LabelSecao}"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"/>

            <!-- E-mail do usuário -->
            <Label Text="joaopedro@jpph.com.br"
                   Style="{StaticResource LabelPequeno}"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"
                   Margin="0,4,0,0"/>

            <!-- Espaço de 24 + linha divisória + espaço de 24 -->
            <BoxView HeightRequest="24" Color="Transparent"/>
            <BoxView HeightRequest="1"
                     BackgroundColor="{StaticResource Divisor}"/>
            <BoxView HeightRequest="24" Color="Transparent"/>

            <!-- ===== CARTÃO COM AS INFORMAÇÕES DA CONTA ===== -->
            <Border Style="{StaticResource CardDefault}">
                <VerticalStackLayout Spacing="0">

                    <!-- Linha 1: perfil ativo (com badge azul-petróleo) -->
                    <Grid ColumnDefinitions="*,Auto"
                          VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="Perfil ativo"
                               Style="{StaticResource LabelCorpo}"/>
                        <Border Grid.Column="1"
                                BackgroundColor="{StaticResource Petroleo}"
                                StrokeShape="RoundRectangle 999"
                                Stroke="Transparent"
                                Padding="12,8">
                            <Label Text="Administrador"
                                   TextColor="{StaticResource Branco}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12"/>
                        </Border>
                    </Grid>

                    <!-- Divisória entre as linhas -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Divisor}"
                             Margin="0,12"/>

                    <!-- Linha 2: empresa -->
                    <Grid ColumnDefinitions="*,Auto"
                          VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="Empresa"
                               Style="{StaticResource LabelCorpo}"/>
                        <Label Grid.Column="1"
                               Text="JP &amp; PH Transportes"
                               Style="{StaticResource LabelCorpo}"
                               FontFamily="OpenSansSemibold"/>
                    </Grid>

                    <!-- Divisória entre as linhas -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="{StaticResource Divisor}"
                             Margin="0,12"/>

                    <!-- Linha 3: status da conta (badge verde) -->
                    <Grid ColumnDefinitions="*,Auto"
                          VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="Status"
                               Style="{StaticResource LabelCorpo}"/>
                        <Border Grid.Column="1"
                                BackgroundColor="{StaticResource VerdeSuave}"
                                StrokeShape="RoundRectangle 999"
                                Stroke="Transparent"
                                Padding="12,8">
                            <Label Text="Aprovado"
                                   TextColor="{StaticResource VerdeEsmeralda}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Espaço de 24 antes do botão de sair -->
            <BoxView HeightRequest="24" Color="Transparent"/>

            <!-- Botão destrutivo: sai da conta e volta ao login -->
            <Button Text="Sair da conta"
                    Style="{StaticResource BtnDestrutivo}"
                    Clicked="OnSairClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
